@page "/"
@using DiscordRP;
@using DiscordRP.Model;
@using System.Diagnostics;
@using System.Threading.Tasks;
@using Newtonsoft.Json;
@using System.IO;

<div class="page-container">
    <div class="ma-4 d-flex justify-center">
        <p class="mr-4">NIKKE is @(_nikkeProcess ? "running" : "not running")</p>
        <p class="mr-4">_isInitialized is @(_isInitialized ? "true" : "false")</p>
        <p class="mr-4">Discord is @(_discordProcess ? "running" : "not running")</p>
    </div>
    <div class="d-flex justify-center">
        <MudSwitch @bind-Value="Switched" LabelPlacement="Placement.End" Color="Color.Primary">
            Turn @(Switched ? "OFF" : "ON") Rich Presence
        </MudSwitch>
    </div>
    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="6">
            <div class="ml-2">
                <MudSelect @bind-Value="SelectedLargeImageKey"
                Variant="Variant.Outlined"
                Label="Select large image"
                Clearable="false">
                    @foreach (var image in largeImageKeyModels)
                    {
                        <MudSelectItem Value="@image.LargeImageKey">
                            <div class="d-flex align-items-center">
                                <MudImage Class="mr-2 rounded-l" Height="30" Width="30" src="@image.LargeImageKeyUrl" Alt="@image.Name"></MudImage>
                                <MudText Class="py-1">@image.Name</MudText>
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudSelect @bind-Value="SelectedSmallImageKey"
                Variant="Variant.Outlined"
                Label="Select small image"
                Clearable="false"
                Class="py-1">
                    @foreach (var image in smallImageKeyModels)
                    {
                        <MudSelectItem Value="@image.SmallImageKey">
                            @if (image.Name != "None")
                            {
                                <div class="d-flex align-items-center">
                                    <MudImage Class="mr-2 rounded-circle" Height="25" Width="25" src="@image.SmallImageKeyUrl" Alt="@image.Name"></MudImage>
                                    <MudText Class="py-1">@image.Name</MudText>
                                </div>
                            }
                            else
                            {
                                @image.Name
                            }
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudTextField Label="Details"
                Variant="Variant.Filled"
                HelperText="The user's current party status. (You can leave this empty)"
                @bind-Value="Details"
                Class="mb-4" />

                <MudTextField Label="State"
                Variant="Variant.Filled"
                HelperText="What the player is currently doing. (You can leave this empty)"
                @bind-Value="State"
                Class="mb-4" />
            </div>
        </MudItem>


        <MudItem xs="12" sm="6">
            <MudPaper Class="mr-2" Elevation="0">
                <MudCardContent>
                    <div class="d-flex">
                        <div class="mr-3">
                            @if (!string.IsNullOrEmpty(avatar))
                            {
                                <MudBadge Class="avatar-container" Origin="Origin.BottomRight" Color="Color.Success" Overlap="true" Bordered="true">
                                    <MudImage Class="main-avatar rounded-circle mt-2 ml-2" Src="@($"https://cdn.discordapp.com/avatars/{userId}/{avatar}")"></MudImage>
                                </MudBadge>
                            }
                            else
                            {
                                <div>
                                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="50px" Height="50px" />
                                </div>
                            }
                        </div>
                        <div class="flex-grow-1">
                            @if (!string.IsNullOrEmpty(username))
                            {
                                <div>
                                    <MudText Class="pt-7 pl-2" Typo="Typo.body1"><strong>@username</strong></MudText>
                                </div>
                            }
                            else
                            {
                                <MudText Typo="Typo.body1" Class="mb-1">Discord:
                                    <MudText Inline="true" Typo="Typo.body1" Color="Color.Error" Class="mb-1"><strong>Not Launched</strong></MudText>
                                </MudText>
                                <div>
                                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="240px" Height="110px" />
                                </div>
                            }
                        </div>
                    </div>
                </MudCardContent>
            </MudPaper>
            <MudText Typo="Typo.h6" Class="mb-2 mt-2">Preview</MudText>
            <MudPaper Class="pa-4 mr-2" Elevation="0">
                <MudCardContent>
                    <MudText Class="mb-1" Typo="Typo.body2">Playing</MudText>
                    <div class="d-flex">
                        <div class="mr-3">
                            @if (selectedLargeImage != null && !string.IsNullOrEmpty(selectedLargeImage.LargeImageKeyUrl))
                            {
                                <div class="avatar-container">
                                    <img src="@selectedLargeImage.LargeImageKeyUrl" class="main-avatar" alt="Large image" />

                                    @if (selectedSmallImage != null && selectedSmallImage.Name != "None" && !string.IsNullOrEmpty(selectedSmallImage.SmallImageKeyUrl))
                                    {
                                        <img src="@selectedSmallImage.SmallImageKeyUrl" class="status-icon" alt="Small image" />
                                    }
                                </div>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body1" Class="mb-1"><strong>Goddess of Victory NIKKE</strong></MudText>
                            @if (!string.IsNullOrEmpty(details))
                            {
                                <div>
                                    <MudText Typo="Typo.caption">@details</MudText>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(state))
                            {
                                <div>
                                    <MudText Typo="Typo.caption">@state</MudText>
                                </div>
                            }
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Success">Playing for 00:01</MudText>
                            </div>
                        </div>
                    </div>
                </MudCardContent>
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>

<MudDivider />
<MudText Typo="Typo.h6" Class="ma-4">Settings</MudText>

<MudSwitch @bind-Value="MinimizeToTraySetting" LabelPlacement="Placement.End" Color="Color.Primary">
    Minimize to tray
</MudSwitch>

<MudSwitch @bind-Value="RunOnStartupSetting" LabelPlacement="Placement.End" Color="Color.Primary">
    Run on Windows startup
</MudSwitch>

<MudSwitch @bind-Value="RichPresenceOnAppStartupSetting" LabelPlacement="Placement.End" Color="Color.Primary">
    Turn Rich Presence automatically on app startup
</MudSwitch>


<div class="loading-bar-container">
    @if (!_isInitialized && Switched == true)
    {
        <MudProgressLinear Color="Color.Primary" Rounded="true" Size="Size.Small" Indeterminate="true" />
    }
</div>


@code {
    private bool _switched = false;
    private bool _nikkeProcess = false;
    private bool _discordProcess = false;
    private bool _isInitialized = false;
    private List<LargeImageKeyModel> largeImageKeyModels = new List<LargeImageKeyModel>();
    private List<SmallImageKeyModel> smallImageKeyModels = new List<SmallImageKeyModel>();
    private ulong userId { get; set; }
    private string username { get; set; }
    private string avatar {get; set; }

    private string selectedLargeImageKey { get; set; } = "nikke";
    public string SelectedLargeImageKey
    {
        get => selectedLargeImageKey;
        set
        {
            if (selectedLargeImageKey != value)
            {
                selectedLargeImageKey = value;
                SendSettings();
            }
        }
    }


    private string selectedSmallImageKey { get; set; } = "nikke-dark";
    public string SelectedSmallImageKey
    {
        get => selectedSmallImageKey;
        set
        {
            if (selectedSmallImageKey != value)
            {
                selectedSmallImageKey = value;
                SendSettings();
            }
        }
    }

    private LargeImageKeyModel selectedLargeImage =>
        largeImageKeyModels.FirstOrDefault(i => i.LargeImageKey == selectedLargeImageKey) ?? new LargeImageKeyModel();

    private SmallImageKeyModel selectedSmallImage =>
    smallImageKeyModels.FirstOrDefault(i => i.SmallImageKey == selectedSmallImageKey) ?? new SmallImageKeyModel();


    private string details = String.Empty;
    public string Details {get => details;
        set
        {
            if(details != value)
            {
                details = value;
                SendSettings();
            }
        } 
    }

    private string state = String.Empty;
    public string State
    {
        get => state;
        set
        {
            if (state != value)
            {
                state = value;
                SendSettings();
            }
        }
    }

    private bool minimizeToTraySetting = true;
    public bool MinimizeToTraySetting {get => minimizeToTraySetting;
        set
        {
            if(minimizeToTraySetting != value)
            {
                minimizeToTraySetting = value;
                SendSettings();
                UpdateMinimizeToTraySettingInWindow(value);
            }
        }
    }

    private bool runOnStartupSetting = false;
    public bool RunOnStartupSetting
    {
        get => runOnStartupSetting;
        set
        {
            if (runOnStartupSetting != value)
            {
                runOnStartupSetting = value;
                SendSettings();
            }
        }
    }

    private bool richPresenceOnAppStartupSetting = false;
    public bool RichPresenceOnAppStartupSetting
    {
        get => richPresenceOnAppStartupSetting;
        set
        {
            if (richPresenceOnAppStartupSetting != value)
            {
                richPresenceOnAppStartupSetting = value;
                SendSettings();
            }
        }
    }

    private bool Switched
    {
        get => _switched;
        set
        {
            if (_switched != value)
            {
                _switched = value;
                if (_switched)
                {
                    StartRP();
                }
            }
        }
    }

    NikkeRichPresence.DiscordRichPresence discordPresence = new NikkeRichPresence.DiscordRichPresence();

    protected override void OnInitialized()
    {
        largeImageKeyModels = Data.LargeImageKeyData;
        smallImageKeyModels = Data.SmallImageKeyData;

        var json = File.ReadAllText("appsettings.json");
        dynamic settings = Newtonsoft.Json.JsonConvert.DeserializeObject(json);

        minimizeToTraySetting = settings.MinimizeToTray;
        runOnStartupSetting = settings.RunOnStartup;
        richPresenceOnAppStartupSetting = settings.RichPresenceEnabledOnStartup;
        var largeImageModel = settings.SelectedLargeImage.ToObject<LargeImageKeyModel>();
        var smallImageModel = settings.SelectedSmallImage.ToObject<SmallImageKeyModel>();
        selectedLargeImageKey = largeImageModel?.LargeImageKey ?? "nikke";
        selectedSmallImageKey = smallImageModel?.SmallImageKey ?? "nikke-dark";
        details = settings.Details;
        state = settings.State;
        _switched = richPresenceOnAppStartupSetting;

        if (_switched)
        {
            StartRP();
        }

    }

    protected override async Task OnInitializedAsync()
    {
        discordPresence.Initialize();
        await discordPresence.GetUserDetails();

        userId = discordPresence.UserId;
        username = discordPresence.Username;
        avatar = discordPresence.Avatar;

        StateHasChanged();

    }

    private async void StartRP()
    {
        StateHasChanged();

        if (Switched == false)
        {
            await StopRP();
        }
        else
        {
            await MonitorProcessAsync("NIKKE");
            await StopRP();
        }
    }

    private async Task MonitorProcessAsync(string processName)
    {
        while (true)
        {
            Process[] processDiscord = Process.GetProcessesByName("Discord");
            Process[] processes = Process.GetProcessesByName(processName);

            if (processes.Length > 0 && _isInitialized == false && processDiscord.Length > 0)
            {
                _nikkeProcess = true;
                _discordProcess = true;
                discordPresence.Initialize();
                discordPresence.SetPresence(selectedLargeImage.LargeImageKey, selectedSmallImage.SmallImageKey, details, state);
                _isInitialized = true;
            }
            else if (processes.Length == 0)
            {
                _nikkeProcess = false;

                if (processDiscord.Length == 0)
                {
                    _discordProcess = false;
                }

                if (_isInitialized)
                {
                    discordPresence.Deinitialize();
                    _isInitialized = false;
                }

                
            }
			else if (processDiscord.Length == 0)
			{
				_discordProcess = false;
				if (_isInitialized)
				{
					discordPresence.Deinitialize();
					_isInitialized = false;
				}
			}

            if (_switched == false)
            {
                break;
            }

            await Task.Delay(10000);
            StateHasChanged();
        }
    }

    private Task StopRP()
    {
        if (_isInitialized == true)
        {        
            discordPresence.Deinitialize();
        }

        _isInitialized = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SendSettings()
    {
        Configuration config = new Configuration();
        await Task.Run(() => config.AppSettings(minimizeToTraySetting, runOnStartupSetting, richPresenceOnAppStartupSetting, selectedLargeImage, selectedSmallImage, details, state));
        if (_isInitialized)
        {
            discordPresence.SetPresence(selectedLargeImage.LargeImageKey, selectedSmallImage.SmallImageKey, details, state);
        }
    }

    private void UpdateMinimizeToTraySettingInWindow(bool enabled)
    {
        var window = App.Current.MainPage.Window as NikkeDRPWindow;
        if (window != null)
        {
            window.UpdateMinimizeToTraySetting(enabled);
        }
    }
}